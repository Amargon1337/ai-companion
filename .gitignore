```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment variables
.env
.env.local
*.env.*
# Real credentials live here — must never be committed
api.env
api.env.txt

# Logs
*.log
bot.log

# Database and data files
data/companion.db
data/faiss_index.bin
data/logs/

# Test cache
.tests/__pycache__/

# Backup files
*.bak
master_summary.txt.bak
```