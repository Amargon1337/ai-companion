{"role": "user", "text": "�� � AI companion bot. ��� ���� �������� ���:\n\n=== companion/models.py ===\n\"\"\"Data models for memory architecture.\"\"\"\nfrom __future__ import annotations\n\nfrom dataclasses import asdict, dataclass, field\nfrom datetime import datetime\nfrom typing import Any, Dict, List, Literal, Optional\nimport uuid\n\nMemoryKind = Literal[\"permanent\", \"state\", \"event\"]\nFactStatus = Literal[\"active\", \"superseded\", \"inactive\", \"archived\"]\nRelationType = Literal[\"supersedes\", \"contradicts\", \"confirms\", \"related_to\"]\nQueryIntent = Literal[\"memory\", \"world\", \"mixed\"]\n\n\ndef _new_id(prefix: str) -> str:\n    return f\"{prefix}_{datetime.now().strftime('%Y%m%d')}_{uuid.uuid4().hex[:8]}\"\n\n\n@dataclass\nclass Fact:\n    fact: str\n    date: str\n    importance: int\n    confidence: float\n    source: str\n    memory_kind: MemoryKind = \"event\"\n    source_type: str = \"message\"\n    tags: List[str] = field(default_factory=list)\n    status: FactStatus = \"active\"\n    valid_from: Optional[str] = None\n    valid_until: Optional[str] = None\n    id: str = \"\"\n    created_at: str = \"\"\n    schema_version: int = 1\n\n    def __post_init__(self) -> None:\n        if not self.id:\n            self.id = _new_id(\"fact\")\n        if not self.created_at:\n            self.created_at = datetime.now().isoformat()\n        if not self.valid_from:\n            self.valid_from = self.date\n\n    def to_dict(self) -> Dict[str, Any]:\n        return asdict(self)\n\n    @classmethod\n    def from_dict(cls, data: Dict[str, Any]) -> \"Fact\":\n        known = {f.name for f in cls.__dataclass_fields__.values()}  # type: ignore[attr-defined]\n        return cls(**{k: v for k, v in data.items() if k in known})\n\n\n@dataclass\nclass FactRelation:\n    from_id: str\n    to_id: str\n    relation: RelationType\n    reason: str = \"\"\n    confidence: float = 0.8\n    id: str = \"\"\n    created_at: str = \"\"\n\n    def __post_init__(self) -> None:\n        if not self.id:\n            self.id = _new_id(\"rel\")\n        if not self.created_at:\n            self.created_at = datetime.now().isoformat()\n\n    def to_dict(self) -> Dict[str, Any]:\n        return asdict(self)\n\n    @classmethod\n    def from_dict(cls, data: Dict[str, Any]) -> \"FactRelation\":\n        known = {f.name for f in cls.__dataclass_fields__.values()}  # type: ignore[attr-defined]\n        return cls(**{k: v for k, v in data.items() if k in known})\n\n\n@dataclass\nclass MessageRecord:\n    role: str\n    text: str\n    importance: int\n    mode: str = \"default\"\n    signals: List[str] = field(default_factory=list)\n    id: str = \"\"\n    ts: str = \"\"\n    user_id: Optional[int] = None\n\n    def __post_init__(self) -> None:\n        if not self.id:\n            self.id = _new_id(\"msg\")\n        if not self.ts:\n            self.ts = datetime.now().isoformat()\n\n    def to_dict(self) -> Dict[str, Any]:\n        return asdict(self)\n\n    @classmethod\n    def from_dict(cls, data: Dict[str, Any]) -> \"MessageRecord\":\n        known = {f.name for f in cls.__dataclass_fields__.values()}  # type: ignore[attr-defined]\n        return cls(**{k: v for k, v in data.items() if k in known})\n\n\n@dataclass\nclass Reflection:\n    insight: str\n    based_on: List[str]\n    period: str\n    importance: int\n    confidence: float\n    status: FactStatus = \"active\"\n    id: str = \"\"\n    created_at: str = \"\"\n\n    def __post_init__(self) -> None:\n        if not self.id:\n            self.id = _new_id(\"refl\")\n        if not self.created_at:\n            self.created_at = datetime.now().isoformat()\n\n    def to_dict(self) -> Dict[str, Any]:\n        return asdict(self)\n\n    @classmethod\n    def from_dict(cls, data: Dict[str, Any]) -> \"Reflection\":\n        known = {f.name for f in cls.__dataclass_fields__.values()}  # type: ignore[attr-defined]\n        return cls(**{k: v for k, v in data.items() if k in known})\n\n\n@dataclass\nclass ContextBundle:\n    \"\"\"Selected context for a single LLM request.\"\"\"\n    facts: List[Fact] = field(default_factory=list)\n    reflections: List[Reflection] = field(default_factory=list)\n    summaries: List[str] = field(default_factory=list)\n    permanent_notes: str = \"\"\n    personality_snapshot: str = \"\"\n\n    def to_prompt_block(self) -> str:\n        parts: List[str] = []\n        if self.personality_snapshot:\n            parts.append(self.personality_snapshot)\n        if self.permanent_notes:\n            parts.append(f\"[���������� ������]\\n{self.permanent_notes}\")\n        if self.reflections:\n            lines = [f\"� {r.insight}\" for r in self.reflections]\n            parts.append(\"[������ � ������������]\\n\" + \"\\n\".join(lines))\n        if self.facts:\n            lines = [\n                f\"� [{f.memory_kind}|{f.importance}/10] {f.fact}\"\n                for f in self.facts\n            ]\n            parts.append(\"[����������� �����]\\n\" + \"\\n\".join(lines))\n        if self.summaries:\n            parts.append(\"[�������� �������]\\n\" + \"\\n\".join(self.summaries))\n        return \"\\n\\n\".join(parts)\n\n\n\n=== companion/bot_core.py ===\n\"\"\"Core bot runtime: sessions, LLM routing, compress.\"\"\"\nfrom __future__ import annotations\n\nimport asyncio\nimport logging\nimport uuid\nfrom typing import Any, Dict, Optional\n\nfrom aiogram import types\n\nfrom companion.config import (\n    ANYA_MEMORY_THRESHOLD,\n    API_TOKEN,\n    SUMMARY_THRESHOLD,\n)\nfrom companion.llm import client as llm\nfrom companion.llm.grounding import classify_intent\nfrom companion.llm.pipeline import run_compress_pipeline\nfrom companion.llm.prompts import (\n    ANYA_MEMORY_UPDATE_PROMPT,\n    ANYA_REFLECT_PROMPT,\n    ANYA_RELATIONSHIP_PROMPT,\n)\nfrom companion.llm.sessions import (\n    create_anya_session,\n    create_debate_session,\n    create_default_session,\n)\nfrom companion.memory.embeddings import SemanticIndex\nfrom companion.memory.importance import detect_crisis, score_message_importance\nfrom companion.memory.retrieval import RetrievalBudgetManager\nfrom companion.memory.store import MemoryStore\nfrom companion.models import Fact\nfrom companion.storage.legacy import LegacyStorage\nfrom companion.runtime_state import RuntimeState\nfrom companion.mood_inference import mood_inference\nfrom companion.policy_layer import policy_layer\nfrom companion.identity_anchors import identity_anchors\nfrom companion.conflict_memory import conflict_memory\nfrom companion.user_model import user_model\nfrom companion.background_workers import background_workers\n\nlogger = logging.getLogger(__name__)\n\n# Global singletons\nmemory_store = MemoryStore()\nretrieval_mgr = RetrievalBudgetManager()\nsemantic_index = SemanticIndex()\n\n# In-memory sessions\nuser_chats: Dict[int, Any] = {}\nuser_message_counts: Dict[int, int] = {}\nuser_modes: Dict[int, str] = {}\nanya_chats: Dict[int, Any] = {}\ndebate_chats: Dict[int, Any] = {}\nanya_message_counts: Dict[int, int] = {}\n_anya_updating: Dict[int, bool] = {}\n\n# Rate limiter for user_model reflection (prevent burst overload)\n_last_reflection_time: Dict[int, float] = {}\n_REFLECTION_COOLDOWN_SECONDS = 60  # 1 minute between reflections\n\n# Rate limiter for LLM requests (prevent API quota exhaustion)\n_user_request_times: Dict[int, List[float]] = {}\n_MAX_REQUESTS_PER_MINUTE = 10\n\n\nasync def send_long_message(message: types.Message, text: str) -> None:\n    for i in range(0, len(text), 4000):\n        await message.answer(text[i : i + 4000])\n\n\nasync def wait_gemini_file_ready(uploaded: Any) -> Any:\n    while uploaded.state.name == \"PROCESSING\":\n        await asyncio.sleep(2)\n        uploaded = await asyncio.to_thread(llm.get_file, uploaded.name)\n    return uploaded\n\n\ndef _query_text(payload: Any) -> str:\n    if isinstance(payload, str):\n        return payload\n    if isinstance(payload, list) and payload:\n        first = payload[0]\n        if isinstance(first, str):\n            return first\n    return \"\"\n\n\nasync def _llm_oneshot(prompt: str) -> str:\n    return await asyncio.to_thread(llm.oneshot, prompt)\n\n\nasync def update_anya_memory(anya_chat: Any) -> None:\n    try:\n        reflect = await asyncio.to_thread(anya_chat.send_message, ANYA_REFLECT_PROMPT)\n        current = LegacyStorage.load_anya_memory()\n        prompt = ANYA_MEMORY_UPDATE_PROMPT.format(\n            reflection=reflect.text,\n            current_memory=__import__(\"json\").dumps(current, ensure_ascii=False, indent=2),\n        )\n        text = await _llm_oneshot(prompt)\n        updated = llm.parse_json_object(text)\n        from datetime import datetime  # noqa: PLC0415\n\n        updated[\"last_updated\"] = datetime.now().isoformat()\n        LegacyStorage.save_anya_memory(updated)\n\n        rel = memory_store.load_anya_relationship()\n        rel_prompt = ANYA_RELATIONSHIP_PROMPT.format(\n            current=__import__(\"json\").dumps(rel, ensure_ascii=False),\n        )\n        rel_text = await _llm_oneshot(rel_prompt + f\"\\n\\n���������:\\n{reflect.text}\")\n        try:\n            rel_updated = llm.parse_json_object(rel_text)\n            memory_store.save_anya_relationship(rel_updated)\n        except Exception:\n            pass\n        # ������ ��� ���������� ������ � ������������� ��� ��������� ���������\n        anya_chats.clear()\n        logger.info(\"������ ��� � ��������� ���������, ������ ��������\")\n    except Exception as e:\n        logger.error(f\"Anya memory update error: {e}\")\n\n\nasync def compress_and_reset(user_id: int) -> Optional[str]:\n    if user_id not in user_chats:\n        return None\n    chat = user_chats[user_id]\n    summary = await asyncio.to_thread(run_compress_pipeline, memory_store, chat, user_id)\n    if not summary:\n        return None\n    # ����� �������� ����� ��������� compress\n    user_message_counts[user_id] = 0\n    hist = [\n        llm.history_item(\"user\", f\"[�������]\\n{summary}\"),\n        llm.history_item(\"model\", \"�����.\"),\n    ]\n    user_chats[user_id] = await asyncio.to_thread(\n        create_default_session, memory_store, retrieval_mgr, hist\n    )\n    return summary\n\n\nasync def process_llm_request(message: types.Message, content_payload: Any) -> None:\n    uid = message.from_user.id\n    mode = user_modes.get(u\n[...��������...]\n\n\n=== companion/handlers.py ===\n\"\"\"Telegram command and message handlers.\"\"\"\nfrom __future__ import annotations\n\nimport asyncio\nimport io\nimport json\nimport logging\nimport os\nimport uuid\nfrom datetime import datetime, timedelta\n\nimport speech_recognition as sr\nimport yt_dlp\nfrom aiogram import F, types\nfrom aiogram.filters import Command\nfrom aiogram.types import BotCommand\nfrom aiogram.utils.keyboard import ReplyKeyboardBuilder\nfrom google.genai import types as google_types\nfrom pydub import AudioSegment\n\nfrom companion import bot_core as core\nfrom companion.config import (\n    BASE_DIR,\n    MAX_DOCUMENT_CHARS,\n    MONTH_NAMES,\n    TEXT_EXTENSIONS,\n)\nfrom companion.llm import client as llm\nfrom companion.llm.prompts import PERSONALITY_REPORT_PROMPT, RETROSPECTIVE_PROMPT\nfrom companion.memory.store import MemoryStore\nfrom companion.storage.legacy import LegacyStorage\n\nlogger = logging.getLogger(__name__)\n\n\ndef get_main_keyboard():\n    builder = ReplyKeyboardBuilder()\n    for btn in [\n        \"/anya\", \"/debate\", \"/me\", \"/todo\", \"/mood\", \"/crisis\",\n        \"/timeline\", \"/notes\", \"/facts\", \"/help\",\n    ]:\n        builder.button(text=btn)\n    builder.adjust(3, 3, 3)\n    return builder.as_markup(resize_keyboard=True, placeholder=\"������ ����������...\")\n\n\ndef register_handlers(dp, bot) -> None:\n    store = core.memory_store\n\n    @dp.message(Command(\"start\"))\n    async def cmd_start(message: types.Message):\n        await message.answer(\n            \"������� ������ v2. Memory architecture active.\\n\\n\"\n            \"���������: <b>������� &lt;�����&gt;</b> � ��������. /facts � �����.\",\n            parse_mode=\"HTML\",\n            reply_markup=get_main_keyboard(),\n        )\n\n    @dp.message(Command(\"help\"))\n    async def cmd_help(message: types.Message):\n        txt = (\n            \"<b>������:</b> /anya, /debate, /me, /mode\\n\"\n            \"<b>���:</b> /reset, /summarize, /context, /stats, /reload\\n\"\n            \"<b>������:</b> /facts [������], /find, /notes, ������� [�����]\\n\"\n            \"<b>�������:</b> /log, /week, /export\\n\"\n            \"<b>�����:</b> /search � Google grounding; ���� � ���� ��� ��������\\n\"\n            \"<b>�����:</b> PDF, TXT, DOCX\\n\"\n            \"<b>����������:</b> /mood, /moodweek\\n\"\n            \"<b>�������:</b> /logcrisis, /crisis\\n\"\n            \"<b>����������:</b> /addevent, /timeline, /year\\n\"\n            \"<b>�����:</b> /monthbook, /yearbook\\n\"\n            \"<b>���������:</b> /personality, /selfie, /memory, /todo, /anyamem, /retrospective\\n\"\n            \"<b>�������:</b> /code, /logs, /dbinfo\\n\"\n            \"<b>Self-awareness:</b> /whoami, /confidence, /errors, /selfmap\\n\"\n            \"<b>Reasoning:</b> /goal � ����, /causal � �����������, /predict � ��������, \"\n            \"/argue � ���������� ����, /think � ������ ������\"\n        )\n        await message.answer(txt, parse_mode=\"HTML\", reply_markup=get_main_keyboard())\n\n    @dp.message(Command(\"facts\"))\n    async def cmd_facts(message: types.Message):\n        args = (message.text or \"\").replace(\"/facts\", \"\").strip()\n        if args:\n            hits = store.search_facts(args, limit=15)\n            if not hits:\n                return await message.answer(f\"������ �� '{args}' ���.\")\n            lines = [\n                f\"� [{f.memory_kind}|{f.importance}/10|{f.status}] {f.fact}\"\n                for f in hits\n            ]\n            return await core.send_long_message(\n                message, f\"����� �� '{args}':\\n\\n\" + \"\\n\".join(lines)\n            )\n        facts = store.list_facts(\"active\")[-20:]\n        if not facts:\n            return await message.answer(\"Fact Store ����. �������� � ����� �������� ��� ������.\")\n        lines = [\n            f\"� [{f.memory_kind}|{f.importance}/10] {f.fact}\" for f in reversed(facts)\n        ]\n        await core.send_long_message(message, \"��������� �����:\\n\\n\" + \"\\n\".join(lines))\n\n    @dp.message(Command(\"anya\", \"debate\", \"me\", \"mode\"))\n    async def cmd_modes(message: types.Message):\n        cmd = message.text.split()[0].replace(\"/\", \"\") if message.text else \"\"\n        uid = message.from_user.id\n        if cmd == \"me\":\n            prev = core.user_modes.pop(uid, \"default\")\n            if prev == \"anya\" and uid in core.anya_chats:\n                asyncio.create_task(core.update_anya_memory(core.anya_chats[uid]))\n                del core.anya_chats[uid]\n                core.anya_message_counts.pop(uid, None)\n            elif prev == \"debate\" and uid in core.debate_chats:\n                del core.debate_chats[uid]\n            await message.answer(\"����� ������� ? Default.\", reply_markup=get_main_keyboard())\n        elif cmd == \"mode\":\n            await message.answer(f\"������� �����: {core.user_modes.get(uid, 'default')}\")\n        else:\n            core.user_modes[uid] = cmd\n            label = {\"anya\": \"���\", \"debate\": \"������\"}.get(cmd, cmd)\n            await message.answer(f\"�����: {label}\", reply_markup=get_main_keyboard())\n\n    @dp.message(Command(\"reset\"))\n    async def cmd_reset(message: types.Message):\n        uid = message.from_user.id\n[...��������...]\n\n\n=== companion/config.py ===\n\"\"\"Configuration, paths, constants.\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom typing import Dict, List\n\nfrom dotenv import load_dotenv\n\nBASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n\n_dotenv = os.path.join(BASE_DIR, \"api.env\")\nif not os.path.exists(_dotenv):\n    _alt = os.path.join(BASE_DIR, \"api.env.txt\")\n    if os.path.exists(_alt):\n        _dotenv = _alt\nload_dotenv(_dotenv)\n\nAPI_TOKEN = os.getenv(\"API_TOKEN\")\nGOOGLE_API_KEY = os.getenv(\"GOOGLE_API_KEY\")\nif not API_TOKEN:\n    raise ValueError(\"API_TOKEN �� ������ � api.env!\")\nif not GOOGLE_API_KEY:\n    raise ValueError(\"GOOGLE_API_KEY �� ������ � api.env!\")\n\n_raw_admins = os.getenv(\"ADMIN_IDS\", \"8390550519\")\nADMIN_IDS: List[int] = [int(x) for x in _raw_admins.split(\",\") if x.strip()]\n\n# Legacy paths (unchanged for compatibility)\nTODO_PATH = os.path.join(BASE_DIR, \"todo.json\")\nPERSONALITY_PATH = os.path.join(BASE_DIR, \"personality.json\")\nTIMELINE_PATH = os.path.join(BASE_DIR, \"timeline.jsonl\")\nCRISIS_PATH = os.path.join(BASE_DIR, \"crisis.jsonl\")\nMOOD_PATH = os.path.join(BASE_DIR, \"mood.jsonl\")\nANYA_MEMORY_PATH = os.path.join(BASE_DIR, \"anya_memory.json\")\nDIARY_PATH = os.path.join(BASE_DIR, \"diary.txt\")\nSUMMARIES_PATH = os.path.join(BASE_DIR, \"summaries.txt\")\nIVAN_PATH = os.path.join(BASE_DIR, \"ivan.txt\")\nANYA_PATH = os.path.join(BASE_DIR, \"anya.txt\")\nPERMANENT_NOTES_PATH = os.path.join(BASE_DIR, \"permanent_notes.txt\")\nMONTHBOOK_DIR = os.path.join(BASE_DIR, \"monthbook\")\n\n# Memory architecture paths\nDATA_DIR = os.path.join(BASE_DIR, \"data\")\nFACTS_PATH = os.path.join(DATA_DIR, \"facts.jsonl\")\nFACT_RELATIONS_PATH = os.path.join(DATA_DIR, \"fact_relations.jsonl\")\nMESSAGES_PATH = os.path.join(DATA_DIR, \"messages.jsonl\")\nREFLECTIONS_PATH = os.path.join(DATA_DIR, \"reflections.jsonl\")\nBELIEFS_PATH = os.path.join(DATA_DIR, \"beliefs.jsonl\")\nANYA_RELATIONSHIP_PATH = os.path.join(DATA_DIR, \"anya_relationship.json\")\nMETA_PATH = os.path.join(DATA_DIR, \"meta.json\")\nSQLITE_PATH = os.path.join(DATA_DIR, \"companion.db\")\nEMBEDDINGS_PATH = os.path.join(DATA_DIR, \"embeddings.json\")\n\nos.makedirs(MONTHBOOK_DIR, exist_ok=True)\nos.makedirs(DATA_DIR, exist_ok=True)\n\nMODEL_NAME = \"gemini-3.1-flash-lite\"\n# ��� Google Search grounding ���������� Gemini 2.0 Flash (June 2026)\n# gemini-2.0-flash-exp-0205 - ���������� ������ � Google Search grounding\n# gemini-3.1-flash-lite �� ������������ grounding, ������� ��������� ������\nSEARCH_MODEL = \"gemini-2.0-flash-exp-0205\"\n\nSUMMARY_THRESHOLD = 50  # ���� 25, ��������� ��� ������� compress\nANYA_MEMORY_THRESHOLD = 20  # ���� 15\nREFLECTION_EVERY_N = 4\nMAX_DOCUMENT_CHARS = 120_000\nRETRIEVAL_CHAR_BUDGET = 4_000\nRETRIEVAL_MAX_FACTS = 15\nRETRIEVAL_MAX_REFLECTIONS = 5\n\nTEXT_EXTENSIONS = {\n    \".txt\", \".md\", \".json\", \".jsonl\", \".csv\", \".tsv\", \".log\",\n    \".py\", \".js\", \".ts\", \".html\", \".htm\", \".xml\", \".yaml\", \".yml\",\n    \".rst\", \".ini\", \".cfg\", \".env\", \".sql\", \".sh\", \".bat\",\n}\n\nMONTH_NAMES = [\n    \"������\", \"�������\", \"����\", \"������\", \"���\", \"����\",\n    \"����\", \"������\", \"��������\", \"�������\", \"������\", \"�������\",\n]\n\nEMPTY_PERSONALITY: Dict = {\n    \"interests\": {}, \"beliefs\": [], \"values\": [], \"fears\": [],\n    \"motivation\": [], \"relationships\": {}, \"habits\": {}, \"addictions\": {},\n    \"strengths\": [], \"weaknesses\": [], \"last_updated\": None, \"changes\": [],\n}\n\nEMPTY_ANYA_MEMORY: Dict = {\n    \"ivan_progress\": [], \"things_i_disagree_with\": [],\n    \"things_i_am_proud_of\": [], \"observations\": [], \"last_updated\": None,\n}\n\nEMPTY_ANYA_RELATIONSHIP: Dict = {\n    \"trust\": 0.7, \"tension\": 0.1, \"agreement\": 0.6, \"attachment\": 0.75,\n    \"shared_topics\": [], \"last_conflict\": None, \"last_updated\": None,\n}\n\nCRISIS_SIGNALS: Dict[str, List[str]] = {\n    \"��������\": [\"������\", \"��������\", \"������\", \"�����\", \"��� ���\"],\n    \"��������\": [\"��������\", \"��������� ����\", \"����������\"],\n    \"�������/������\": [\"������\", \"�������\", \"������� �������\", \"�� ���� �����������\"],\n    \"������������\": [\"�� ������������\", \"��� ������\", \"��� ������\", \"��������\"],\n    \"������\": [\"���� �������\", \"�� ���� ����\", \"���� ���������\", \"����� � ������\", \"������\"],\n    \"������������� ����\": [\"����� � ���\", \"�� ���� ������\", \"�� �������\"],\n}\n\n\n\n=== companion/memory/store.py ===\n\"\"\"Unified memory store � facts, messages, relations, reflections, beliefs.\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport logging\nimport re\nfrom datetime import datetime\nfrom typing import Any, Dict, List, Optional, Tuple\n\nfrom companion.config import (\n    ANYA_RELATIONSHIP_PATH,\n    BELIEFS_PATH,\n    FACT_RELATIONS_PATH,\n    FACTS_PATH,\n    MESSAGES_PATH,\n    META_PATH,\n    PERSONALITY_PATH,\n    REFLECTIONS_PATH,\n    EMPTY_ANYA_RELATIONSHIP,\n    EMPTY_PERSONALITY,\n)\nfrom companion.memory.importance import days_since\nfrom companion.memory.text_sim import text_overlap\nfrom companion.models import Fact, FactRelation, MessageRecord, Reflection\nfrom companion.storage.jsonl import append_jsonl, read_jsonl\nfrom companion.storage.sqlite_db import MemoryDatabase\n\nlogger = logging.getLogger(__name__)\n\n\nclass MemoryStore:\n    def __init__(self) -> None:\n        self.db = MemoryDatabase()\n\n    # ?? Meta ??????????????????????????????????????????????????????????\n\n    def get_compress_count(self) -> int:\n        return int(self.db.get_meta(\"compress_count\", \"0\"))\n\n    def increment_compress_count(self) -> int:\n        n = self.get_compress_count() + 1\n        self.db.set_meta(\"compress_count\", str(n))\n        self._save_meta_file(\"compress_count\", n)\n        return n\n\n    def _save_meta_file(self, key: str, value: Any) -> None:\n        meta = {}\n        try:\n            with open(META_PATH, \"r\", encoding=\"utf-8\") as f:\n                meta = json.load(f)\n        except (FileNotFoundError, json.JSONDecodeError):\n            pass\n        meta[key] = value\n        with open(META_PATH, \"w\", encoding=\"utf-8\") as f:\n            json.dump(meta, f, ensure_ascii=False, indent=2)\n\n    # ?? Messages ??????????????????????????????????????????????????????\n\n    def log_message(\n        self,\n        role: str,\n        text: str,\n        importance: int,\n        mode: str = \"default\",\n        signals: Optional[List[str]] = None,\n        user_id: Optional[int] = None,\n    ) -> MessageRecord:\n        msg = MessageRecord(\n            role=role,\n            text=text,\n            importance=importance,\n            mode=mode,\n            signals=signals or [],\n            user_id=user_id,\n        )\n        d = msg.to_dict()\n        append_jsonl(MESSAGES_PATH, d)\n        self.db._insert_message(d)\n        return msg\n\n    def recent_messages(\n        self, min_importance: int = 0, limit: int = 50\n    ) -> List[MessageRecord]:\n        rows = self.db.list_messages(min_importance=min_importance, limit=limit)\n        return [MessageRecord.from_dict(r) for r in rows]\n\n    # ?? Facts ?????????????????????????????????????????????????????????\n\n    def add_fact(self, fact: Fact) -> Fact:\n        d = fact.to_dict()\n        self.db._insert_fact(d)  # SQLite ������ (ACID ��������)\n        append_jsonl(FACTS_PATH, d)  # JSONL ������ (append-only audit log)\n        return fact\n\n    def list_facts(self, status: str = \"active\") -> List[Fact]:\n        rows = self.db.list_facts(status=status)\n        return [Fact.from_dict(r) for r in rows]\n\n    def list_all_facts(self) -> List[Fact]:\n        rows = self.db.list_all_facts()\n        return [Fact.from_dict(r) for r in rows]\n\n    def search_facts(self, query: str, limit: int = 20) -> List[Fact]:\n        q = query.lower()\n        hits = [\n            f for f in self.list_facts(\"active\")\n            if q in f.fact.lower()\n            or any(q in t.lower() for t in f.tags)\n        ]\n        if not hits:\n            hits = [\n                f for f in self.list_facts(\"active\")\n                if any(w in f.fact.lower() for w in q.split() if len(w) > 3)\n            ]\n        return hits[:limit]\n\n    def supersede_fact(self, old_id: str, new_id: str, reason: str = \"\") -> None:\n        self.db.update_fact_status(old_id, \"superseded\")\n        rel = FactRelation(\n            from_id=new_id,\n            to_id=old_id,\n            relation=\"supersedes\",\n            reason=reason,\n        )\n        self.add_relation(rel)\n\n    def add_relation(self, rel: FactRelation) -> None:\n        d = rel.to_dict()\n        append_jsonl(FACT_RELATIONS_PATH, d)\n        self.db._insert_relation(d)\n        if rel.relation == \"supersedes\":\n            self.db.update_fact_status(rel.to_id, \"superseded\")\n\n    def get_active_fact_texts(self) -> List[str]:\n        return [f.fact for f in self.list_facts(\"active\")]\n\n    def find_similar_fact(self, text: str, threshold: float = 0.52) -> Optional[Fact]:\n        \"\"\"Dedup via char n-grams � ��������� � ������� ����������.\"\"\"\n        norm = self._normalize(text)\n        best: Optional[Fact] = None\n        best_score = 0.0\n        for f in self.list_facts(\"active\"):\n            score = text_overlap(norm, self._normalize(f.fact))\n            if score > best_score:\n                best_score = score\n                best = f\n        return best if best_score >= threshold else None\n\n    @staticmethod\n    def _normalize(text: str) -> str:\n        return re.sub(r\"\\s+\", \" \", text.lower().strip())\n\n\n[...��������...]\n\n\n=== companion/memory/retrieval.py ===\n\"\"\"Retrieval Budget Manager � ranked context within token budget.\"\"\"\nfrom __future__ import annotations\n\nfrom typing import List, Optional\n\nfrom companion.config import (\n    RETRIEVAL_CHAR_BUDGET,\n    RETRIEVAL_MAX_FACTS,\n    RETRIEVAL_MAX_REFLECTIONS,\n)\nfrom companion.memory.importance import retrieval_score\nfrom companion.models import ContextBundle, Fact, Reflection\n\n\nclass RetrievalBudgetManager:\n    def __init__(\n        self,\n        char_budget: int = RETRIEVAL_CHAR_BUDGET,\n        max_facts: int = RETRIEVAL_MAX_FACTS,\n        max_reflections: int = RETRIEVAL_MAX_REFLECTIONS,\n    ) -> None:\n        self.char_budget = char_budget\n        self.max_facts = max_facts\n        self.max_reflections = max_reflections\n\n    def select(\n        self,\n        query: str,\n        facts: List[Fact],\n        reflections: List[Reflection],\n        summaries: Optional[List[str]] = None,\n        permanent_notes: str = \"\",\n        personality_snapshot: str = \"\",\n        include_archived: bool = False,\n    ) -> ContextBundle:\n        summaries = summaries or []\n\n        active_facts = [\n            f for f in facts\n            if f.status == \"active\" or (include_archived and f.status != \"inactive\")\n        ]\n        ranked_facts = sorted(\n            active_facts,\n            key=lambda f: retrieval_score(f.to_dict(), query),\n            reverse=True,\n        )[: self.max_facts]\n\n        active_refl = [r for r in reflections if r.status == \"active\"]\n        ranked_refl = sorted(\n            active_refl,\n            key=lambda r: (\n                r.importance / 10.0\n                + (0.5 if query and query.lower() in r.insight.lower() else 0)\n            ),\n            reverse=True,\n        )[: self.max_reflections]\n\n        # Pick at most one recent summary by keyword overlap\n        picked_summaries: List[str] = []\n        if summaries:\n            if query:\n                q = query.lower()\n                for s in reversed(summaries):\n                    if q in s.lower():\n                        picked_summaries = [s[:1500]]\n                        break\n            if not picked_summaries and summaries:\n                picked_summaries = [summaries[-1][:1500]]\n\n        bundle = ContextBundle(\n            facts=ranked_facts,\n            reflections=ranked_refl,\n            summaries=picked_summaries,\n            permanent_notes=permanent_notes[:800] if permanent_notes else \"\",\n            personality_snapshot=personality_snapshot,\n        )\n\n        # Trim if over budget\n        while len(bundle.to_prompt_block()) > self.char_budget and bundle.facts:\n            bundle.facts.pop()\n        while len(bundle.to_prompt_block()) > self.char_budget and bundle.summaries:\n            bundle.summaries.pop()\n        while len(bundle.to_prompt_block()) > self.char_budget and bundle.reflections:\n            bundle.reflections.pop()\n\n        return bundle\n\n\n\n=== companion/memory/importance.py ===\n\"\"\"Importance scoring and decay � never delete, only lower relevance.\"\"\"\nfrom __future__ import annotations\n\nimport math\nimport re\nfrom datetime import datetime\nfrom typing import Dict, List, Tuple\n\nfrom companion.config import CRISIS_SIGNALS\n\n\ndef score_message_importance(text: str, is_crisis: bool = False) -> Tuple[int, List[str]]:\n    \"\"\"Heuristic importance 1-10 for a single message.\"\"\"\n    signals: List[str] = []\n    score = 4\n    t = text.lower()\n    length = len(text)\n\n    if is_crisis:\n        score += 3\n        signals.append(\"crisis\")\n    if length > 400:\n        score += 1\n        signals.append(\"long\")\n    if length > 800:\n        score += 1\n    if \"?\" in text and any(w in t for w in (\"�������\", \"������\", \"��������\")):\n        score += 1\n        signals.append(\"memory_query\")\n    if any(w in t for w in (\"�����\", \"�������\", \"������\", \"�������\", \"�����\")):\n        score += 2\n        signals.append(\"emphasis\")\n    if re.search(r\"[�-ߨ][�-��]+\", text):\n        signals.append(\"named_entity\")\n\n    return max(1, min(10, score)), signals\n\n\ndef detect_crisis(text: str | None) -> Tuple[bool, str]:\n    if not text:\n        return False, \"\"\n    t = text.lower()\n    for cause, kws in CRISIS_SIGNALS.items():\n        if any(kw in t for kw in kws):\n            return True, cause\n    return False, \"\"\n\n\ndef decay_factor(days_old: float, memory_kind: str) -> float:\n    \"\"\"Returns multiplier 0..1. Permanent facts barely decay.\"\"\"\n    if memory_kind == \"permanent\":\n        return 1.0\n    if memory_kind == \"state\":\n        half_life = 45.0\n    else:\n        half_life = 120.0\n    if days_old <= 0:\n        return 1.0\n    return max(0.15, math.exp(-0.693 * days_old / half_life))\n\n\ndef days_since(iso_date: str) -> float:\n    try:\n        if \"T\" in iso_date:\n            dt = datetime.fromisoformat(iso_date)\n        else:\n            dt = datetime.strptime(iso_date[:10], \"%Y-%m-%d\")\n        return max(0.0, (datetime.now() - dt).total_seconds() / 86400)\n    except (ValueError, TypeError):\n        return 0.0\n\n\ndef retrieval_score(\n    fact: Dict,\n    query: str = \"\",\n    *,\n    w_importance: float = 0.4,\n    w_recency: float = 0.25,\n    w_relevance: float = 0.35,\n) -> float:\n    importance = int(fact.get(\"importance\", 5)) / 10.0\n    kind = fact.get(\"memory_kind\", \"event\")\n    age = days_since(fact.get(\"date\") or fact.get(\"created_at\", \"\"))\n    recency = decay_factor(age, kind)\n\n    relevance = 0.3\n    if query:\n        q = query.lower()\n        ft = fact.get(\"fact\", \"\").lower()\n        tags = [t.lower() for t in fact.get(\"tags\", [])]\n        if q in ft:\n            relevance = 1.0\n        else:\n            qw = set(q.split())\n            fw = set(ft.split())\n            overlap = len(qw & fw) / max(len(qw), 1)\n            tag_hit = any(q in tag or tag in q for tag in tags)\n            relevance = min(1.0, overlap * 0.8 + (0.3 if tag_hit else 0))\n    elif kind == \"permanent\":\n        relevance = 0.9\n    elif kind == \"state\" and fact.get(\"status\") == \"active\":\n        relevance = 0.85\n\n    return (\n        w_importance * importance\n        + w_recency * recency\n        + w_relevance * relevance\n    )\n\n\ndef tier_for_importance(importance: int) -> str:\n    if importance >= 8:\n        return \"core\"\n    if importance >= 5:\n        return \"standard\"\n    return \"archive\"\n\n\n\n=== companion/storage/sqlite_db.py ===\n\"\"\"SQLite backend � Phase 5, used as primary store with jsonl mirror.\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport sqlite3\nfrom contextlib import contextmanager\nfrom typing import Any, Dict, Generator, List, Optional\n\nfrom companion.config import SQLITE_PATH\nfrom companion.storage.jsonl import read_jsonl\n\n\nclass MemoryDatabase:\n  def __init__(self, path: str = SQLITE_PATH) -> None:\n    self.path = path\n    self._init_schema()\n    self._migrate_jsonl_if_empty()\n\n  @contextmanager\n  def _conn(self) -> Generator[sqlite3.Connection, None, None]:\n    conn = sqlite3.connect(self.path)\n    conn.row_factory = sqlite3.Row\n    try:\n      yield conn\n      conn.commit()\n    finally:\n      conn.close()\n\n  def _init_schema(self) -> None:\n    with self._conn() as conn:\n      conn.executescript(\n        \"\"\"\n        CREATE TABLE IF NOT EXISTS facts (\n          id TEXT PRIMARY KEY,\n          fact TEXT NOT NULL,\n          date TEXT,\n          created_at TEXT,\n          memory_kind TEXT DEFAULT 'event',\n          importance INTEGER DEFAULT 5,\n          confidence REAL DEFAULT 0.8,\n          source TEXT,\n          source_type TEXT,\n          tags TEXT DEFAULT '[]',\n          status TEXT DEFAULT 'active',\n          valid_from TEXT,\n          valid_until TEXT,\n          schema_version INTEGER DEFAULT 1\n        );\n        CREATE INDEX IF NOT EXISTS idx_facts_status ON facts(status);\n        CREATE INDEX IF NOT EXISTS idx_facts_importance ON facts(importance);\n        CREATE INDEX IF NOT EXISTS idx_facts_date ON facts(date);\n\n        CREATE TABLE IF NOT EXISTS fact_relations (\n          id TEXT PRIMARY KEY,\n          from_id TEXT NOT NULL,\n          to_id TEXT NOT NULL,\n          relation TEXT NOT NULL,\n          created_at TEXT,\n          reason TEXT,\n          confidence REAL DEFAULT 0.8\n        );\n\n        CREATE TABLE IF NOT EXISTS messages (\n          id TEXT PRIMARY KEY,\n          ts TEXT,\n          role TEXT,\n          text TEXT,\n          importance INTEGER DEFAULT 5,\n          mode TEXT DEFAULT 'default',\n          signals TEXT DEFAULT '[]',\n          user_id INTEGER\n        );\n        CREATE INDEX IF NOT EXISTS idx_messages_ts ON messages(ts);\n        CREATE INDEX IF NOT EXISTS idx_messages_importance ON messages(importance);\n\n        CREATE TABLE IF NOT EXISTS reflections (\n          id TEXT PRIMARY KEY,\n          insight TEXT NOT NULL,\n          based_on TEXT DEFAULT '[]',\n          period TEXT,\n          importance INTEGER DEFAULT 7,\n          confidence REAL DEFAULT 0.8,\n          status TEXT DEFAULT 'active',\n          created_at TEXT\n        );\n\n        CREATE TABLE IF NOT EXISTS beliefs (\n          id TEXT PRIMARY KEY,\n          belief TEXT NOT NULL,\n          based_on TEXT DEFAULT '[]',\n          importance INTEGER DEFAULT 6,\n          status TEXT DEFAULT 'active',\n          created_at TEXT\n        );\n\n        CREATE TABLE IF NOT EXISTS meta (\n          key TEXT PRIMARY KEY,\n          value TEXT\n        );\n\n        CREATE TABLE IF NOT EXISTS embeddings (\n          id TEXT PRIMARY KEY,\n          ref_type TEXT,\n          ref_id TEXT,\n          vector TEXT,\n          updated_at TEXT\n        );\n        \"\"\"\n      )\n\n  def _migrate_jsonl_if_empty(self) -> None:\n    from companion.config import (\n      FACT_RELATIONS_PATH,\n      FACTS_PATH,\n      MESSAGES_PATH,\n      REFLECTIONS_PATH,\n      BELIEFS_PATH,\n    )\n\n    with self._conn() as conn:\n      count = conn.execute(\"SELECT COUNT(*) FROM facts\").fetchone()[0]\n      if count > 0:\n        return\n\n    for path, table, mapper in (\n      (FACTS_PATH, \"facts\", self._insert_fact),\n      (FACT_RELATIONS_PATH, \"fact_relations\", self._insert_relation),\n      (MESSAGES_PATH, \"messages\", self._insert_message),\n      (REFLECTIONS_PATH, \"reflections\", self._insert_reflection),\n      (BELIEFS_PATH, \"beliefs\", self._insert_belief),\n    ):\n      if os.path.exists(path):\n        for row in read_jsonl(path):\n          mapper(row)\n\n  def _insert_fact(self, row: Dict[str, Any]) -> None:\n    with self._conn() as conn:\n      conn.execute(\n        \"\"\"\n        INSERT OR IGNORE INTO facts VALUES\n        (?,?,?,?,?,?,?,?,?,?,?,?,?,?)\n        \"\"\",\n        (\n          row[\"id\"], row[\"fact\"], row.get(\"date\"), row.get(\"created_at\"),\n          row.get(\"memory_kind\", \"event\"), row.get(\"importance\", 5),\n          row.get(\"confidence\", 0.8), row.get(\"source\"), row.get(\"source_type\"),\n          json.dumps(row.get(\"tags\", []), ensure_ascii=False),\n          row.get(\"status\", \"active\"), row.get(\"valid_from\"),\n          row.get(\"valid_until\"), row.get(\"schema_version\", 1),\n        ),\n      )\n\n  def _insert_relation(self, row: Dict[str, Any]) -> None:\n    with self._conn() as conn:\n      conn.execute(\n        \"INSERT OR IGNORE INTO fact_relations VALUES (?,?,?,?,?,?,?)\",\n        (\n          row[\"id\"], row[\"from_id\"], row[\"to_id\"], row[\"relation\"],\n          row.get(\"created_at\"), row.get(\"reason\", \"\"), row.get(\"confidence\", 0.8),\n        ),\n      )\n\n  def _insert_message(self, row: Dic\n[...��������...]\n\n\n������ ������������: ������������� ���� ���, ��� ����� �������� ��� ��������\n\n������ �� ������ � ����� �����������, ���������� ��� ���������. ���� ����������, ��������� ������� ���� ���� �����.", "importance": 10, "mode": "default", "signals": ["crisis", "long", "memory_query", "emphasis", "named_entity"], "id": "msg_20260609_816e9550", "ts": "2026-06-09T13:39:56.388743", "user_id": 564836525}
{"role": "assistant", "text": "��� ���������� ������-��������� � ����������� ������ ����������, ������� ���� AMD A8 ����� ������ �����. ����� �������� SQLite-�������������� � ������ ������� JSONL ��� `sqlite3` � `WAL`-�������, ����� �� ������� IO-�������.", "importance": 4, "mode": "default", "signals": [], "id": "msg_20260609_ca7b4da7", "ts": "2026-06-09T13:39:58.598476", "user_id": 564836525}
